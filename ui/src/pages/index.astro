		<div/> <div/>
		<a id="source-link" href="https://github.com/fe-fe/site/">
			source code
		</a>
	</Navbar>

	<div id="bio-card">
		<Box laceBorder={true} class="bg-myg w-fixed">
			<div class="flex font-lg">
				mafer
			</div>
			<p class="font-md">
				jamanta gordaja man ta gordaja manta gordajam anta gor daja 
				manta gordaja manta gordaj ama nta gor dajama nta gordaj ama nta gorda
			</p>
		</Box>
	</div>		
	<RecentlyPlayedBox />
</Layout>

<style>
	#bio-card {
		display: flex;
		flex-direction: column;
		height: 30vh;
		justify-content: end;
	}

	#source-link {
		text-decoration: none;
		color: black;
	}

</style>